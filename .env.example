# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Drive folder IDs (the last part of the folder URL)
ROOT_FOLDER_ID=          # PO invoices root
NON_PO_FOLDER_ID=        # Non-PO invoices root

# Local output folders picked up by SAP
# Example: C:\SAP_Data\Invoices\PO
PO_STAGING_PATH=
NON_PO_STAGING_PATH=

# Gmail SMTP (use an app password, not your account password)
GMAIL_USER=
GMAIL_PASSWORD=

# How many recent "Month-YY" folders to scan per location (default 2 = this + last month).
# Catches invoices filed late. Already-processed files are skipped, so higher is safe.
MONTHS_LOOKBACK=2

# Set to true to only list what WOULD be processed (same as: python main.py --dry-run)
DRY_RUN=false

# Team dashboard: the HTML page is rewritten after every run. Point this at a folder the
# team can open (a shared network folder works). Contains invoice data: restrict access.
DASHBOARD_PATH=dashboard/index.html
# Warn on the dashboard when the bot has not run for this many hours (default 24)
DASHBOARD_STALE_HOURS=24

# Comma-separated list of report recipients
RECEIVER_EMAILS=a@example.com,b@example.com

# Live dashboard server (python serve_dashboard.py)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Required when DASHBOARD_HOST is not 127.0.0.1
DASHBOARD_PASSWORD=
DASHBOARD_REFRESH_SECONDS=30
