# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Drive folder IDs (the last part of the folder URL)
ROOT_FOLDER_ID=          # PO invoices root
NON_PO_FOLDER_ID=        # Non-PO invoices root

# Local output folders picked up by SAP
# Example: C:\SAP_Data\Invoices\PO
PO_STAGING_PATH=
NON_PO_STAGING_PATH=

# Gmail SMTP (use an app password, not your account password)
GMAIL_USER=
GMAIL_PASSWORD=

# Comma-separated list of report recipients
RECEIVER_EMAILS=a@example.com,b@example.com
